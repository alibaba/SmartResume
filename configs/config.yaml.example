
model:
  name: "qwen-turbo"
  api_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  api_key: "your-api-key-here"
  max_tokens: 4096
  temperature: 0
  top_p: 1.0
  seed: 0

channels:
  default:
    name: "qwen-turbo"
    api_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    api_key: "your-api-key-here"
    max_tokens: 4096
    temperature: 0
    top_p: 1.0
    seed: 0

  local_qwen:
    name: "models/Qwen3-0.6B-v2"
    api_url: "http://localhost:8000/v1"
    api_key: "local"
    max_tokens: 2048
    temperature: 0.1
    top_p: 0.95
    seed: 0

extract_channels:
  basic_info: "local_qwen"
  work_experience: "local_qwen"
  education: "local_qwen"
  project_experience: "local_qwen"
  skills_strengths: "local_qwen"
  publication: "local_qwen"
  competition: "local_qwen"
  honor: "local_qwen"
  research_direction: "local_qwen"
  social_profile: "local_qwen"

processing:
  use_force_ocr: false
  
  use_force_json: false
  
  use_pdf_raw_text: false
  
  remove_position_and_company_line: false

ocr:
  ocr_provider: "default"
  
  device: auto
  
  confidence_threshold: 0.5

layout_detection:
  enabled: true

use_direct_models: true
direct_model_name: "models/Qwen3-0.6B-v2"

model_download:
  source: "modelscope"
  models_dir:
    llm: "models"
    layout: "models"
  auto_download: true
